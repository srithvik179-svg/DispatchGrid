# DispatchGrid Backend Environment Configuration
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database
DATABASE_URL=sqlite:///./seed.db

# Simulation Clock Defaults
SIMULATION_CLOCK_DEFAULT=2026-11-02T10:00:00+05:30

# CORS Allowed Origins (comma-separated or JSON list)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
