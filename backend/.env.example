# DispatchGrid Backend Environment Configuration
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# PostgreSQL Connection Settings
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dispatchgrid

# Optional full connection string (overrides the parameters above if supplied)
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/dispatchgrid

# Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_CONNECT_TIMEOUT=5

# Simulation Clock Defaults
SIMULATION_CLOCK_DEFAULT=2026-11-02T10:00:00+05:30

# CORS Allowed Origins (JSON array or comma-separated list)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
